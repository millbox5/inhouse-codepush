# ===========================================================================
#  In-House Code Push — SERVER environment
#  Read by server/lib/src/config/env.dart. These configure the dashboard + API.
#
#  For local dev you usually DON'T edit this file: tooling/dashboard-serve.sh
#  sets these for you from tooling/config.env. Use this file when you run or
#  deploy the server directly (Docker, systemd, a PaaS, etc.).
# ===========================================================================

# Bearer token guarding /admin/* (and injected into the dashboard page). CHANGE IT.
ADMIN_TOKEN=dev-admin-token-change-me

# Device-reachable base advertised in patch download URLs.
#   emulator: http://10.0.2.2:8080  ·  LAN: http://<your-ip>:8080  ·  tunnel: https://…
PUBLIC_BASE_URL=http://localhost:8080

# Where patch artifacts + the JSON registry are stored (relative to server/).
PATCH_STORAGE_DIR=_patches

# Pre-filled in the dashboard's upload form.
CODEPUSH_APP_ID=com.example.app
CODEPUSH_RELEASE_VERSION=1.0.0

# Optional RSA private key (PEM path) to sign patch hashes. Empty = signing off.
PATCH_PRIVATE_KEY_PATH=

# Branch-picker build integration (optional). Point at tooling/push-branch.sh
# and the git worktree it builds in. Empty = branch picker hidden in the UI.
PUSH_BRANCH_SCRIPT=
WORKTREE_DIR=
