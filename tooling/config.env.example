# ===========================================================================
#  In-House Code Push — tooling configuration
#  Copy this file to `config.env` and fill it in. Every script in tooling/
#  sources it. config.env is gitignored (it holds your paths + admin token).
# ===========================================================================

# --- Flutter toolchain (MUST match your hook'd engine) ---------------------
# Path to the EXACT flutter binary whose engine you patched + shipped in the
# app. A patch built with a different Flutter/engine version crashes on load.
FLUTTER_BIN="$HOME/fvm/versions/3.35.2/bin/flutter"

# Dart snapshot hash of the engine inside your INSTALLED app. A build is
# refused unless the fresh libapp.so contains this string (else it SIGABRTs on
# device). Extract it once — see docs/PATCH-HOWTO.md ("find your snapshot hash").
ENGINE_SNAPSHOT="REPLACE_WITH_YOUR_ENGINE_SNAPSHOT_HASH"

# --- Your app --------------------------------------------------------------
APP_ID="com.example.app"             # package id devices send in the check call
# Release the patch targets. MUST equal the release INSTALLED on the device,
# not necessarily the branch's pubspec version.
RELEASE_VERSION="1.0.0"
ARCH="arm64"                         # arm64 | arm | x64

# The Flutter app project to build. For branch builds, point WORKTREE_DIR at a
# DEDICATED git worktree so checkouts never disturb your main clone.
APP_DIR="$HOME/code/myapp"
WORKTREE_DIR="$HOME/code/myapp"      # repo root that branch checkouts reset
WATCH_BRANCH="develop"               # branch autopatch.sh watches for changes

# --- Build knobs -----------------------------------------------------------
BUILD_FLAVOR=""                      # e.g. "prod" -> adds --flavor prod (blank = none)
BUILD_TARGET_PLATFORM="android-arm64"
PRE_BUILD_CMD=""                     # optional, run in APP_DIR before build, e.g. "make codegen"

# Gitignored files (signing keys etc.) to copy into APP_DIR before each build.
# Space-separated relative paths, pulled from SIGNING_SRC_DIR. Blank = skip.
SIGNING_FILES=""                     # e.g. "android/key.properties android/key.jks"
SIGNING_SRC_DIR=""                   # e.g. "$HOME/code/myapp-main"

# --- Dashboard / server ----------------------------------------------------
DASHBOARD_URL="http://localhost:8080"
ADMIN_TOKEN="dev-admin-token-change-me"   # CHANGE THIS
SERVER_DIR="$HOME/code/inhouse-codepush/server"
SERVER_PORT="8080"
# Device-reachable base the server advertises in patch download URLs.
# Emulator: http://10.0.2.2:8080 · LAN: http://<your-ip>:8080 · tunnel: https://...
PUBLIC_BASE_URL="http://10.0.2.2:8080"
# Server's patch store, so the full APK is dropped next to the patch for
# sideloading via the dashboard's "Download APK" button. Blank = skip.
PATCH_STORAGE_DIR="$SERVER_DIR/_patches"

# --- Updater injection (inject-updater.sh — optional) ----------------------
# Only needed if you DON'T commit inhouse_updater.dart into your app (e.g. you
# build from an upstream branch that lacks it). It copies the updater in and
# wires two lines into main.dart using these verbatim anchors:
MAIN_DART="lib/main.dart"            # relative to APP_DIR
APP_PACKAGE_NAME="myapp"             # your pubspec `name:` (used in the import)
INJECT_IMPORT_ANCHOR="import 'package:myapp/app.dart';"        # import inserted before this
INJECT_CALL_ANCHOR="WidgetsFlutterBinding.ensureInitialized();" # check() inserted after this
